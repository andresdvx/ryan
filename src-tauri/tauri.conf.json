{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ryan",
  "version": "0.1.0",
  "identifier": "com.zenpet.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ryan",
        "url": "index.html",
        "width": 90,
        "height": 90,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "chat",
        "title": "Ryan - Chat",
        "url": "chat.html",
        "width": 620,
        "height": 720,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}